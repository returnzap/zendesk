{
  "name": "ReturnZap",
  "author": {
    "name": "ReturnZap",
    "email": "support@returnzap.com",
    "url": "https://returnzap.com"
  },
  "defaultLocale": "en",
  "version": "1.0.0",
  "frameworkVersion": "2.0",
  "private": false,
  "location": {
    "support": {
      "ticket_sidebar": {
        "url": "assets/iframe.html",
        "flexible": true
      }
    }
  },
  "domainWhitelist": [
    "__API_HOST__"
  ],
  "parameters": [
    {
      "name": "api_token",
      "type": "text",
      "secure": "__SECURE__",
      "required": true,
      "scopes": [
        "header"
      ]
    }
  ]
}
